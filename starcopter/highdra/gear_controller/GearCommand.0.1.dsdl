# Single Gear Setpoint sufficient for both gears
# received by Gear Controller. short live time (timeout after receive ~1s)
# overwrites received messages (setpoint) of type starcopter.GearState.0.1 

uint4 command

uint4 COMMAND_NONE    = 0
uint4 COMMAND_EXTEND  = 1
uint4 COMMAND_RETRACT = 2
uint4 COMMAND_STOP    = 3

@sealed